<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.drakescraft_labs</groupId>
  <artifactId>Quaptics-drake</artifactId>
  <name>Quaptics</name>
  <version>0</version>
  <build>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <finalName>Quaptics</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <relocations>
            <relocation>
              <pattern>org.metamechanists.metalib</pattern>
              <shadedPattern>org.metamechanists.quaptics.metalib</shadedPattern>
            </relocation>
            <relocation>
              <pattern>org.metamechanists.displaymodellib</pattern>
              <shadedPattern>org.metamechanists.quaptics.displaymodellib</shadedPattern>
            </relocation>
          </relocations>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>META-INF/*</exclude>
              </excludes>
            </filter>
          </filters>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>mojang</id>
      <url>https://libraries.minecraft.net/</url>
    </repository>
    <repository>
      <id>drakes-local-descriptors</id>
      <url>file://${maven.multiModuleProjectDirectory}/third-party/maven-repo</url>
    </repository>
    <repository>
      <id>org.metamechanists</id>
      <url>https://repo.metamechanists.org/releases/</url>
    </repository>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
    <repository>
      <id>aikar</id>
      <url>https://repo.aikar.co/content/groups/aikar/</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>1.21.11-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.46</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.github.drakescraft_labs</groupId>
      <artifactId>slimefun-core</artifactId>
      <version>11.0-Universal-26.x-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>3.0.2</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <lombok.version>1.18.46</lombok.version>
    <networks.version>11.0.0-drake.6</networks.version>
    <sefilib.version>0.3.1-DRAKE-SNAPSHOT</sefilib.version>
    <jsr305.version>3.0.2</jsr305.version>
    <infinitylib.version>1.3.11-UNIVERSAL-26x-SNAPSHOT</infinitylib.version>
    <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
    <maven.deploy.skip>false</maven.deploy.skip>
    <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
    <slimefun.drake.version>11.0-Universal-26.x-SNAPSHOT</slimefun.drake.version>
  </properties>
</project>
